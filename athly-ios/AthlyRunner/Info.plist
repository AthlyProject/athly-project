<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>pt-BR</string>
	<key>CFBundleDisplayName</key>
	<string>Athly</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>DEV_API_URL</key>
	<string>$(DEV_API_URL)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>O Athly usa a camera para criar fotos com a marca d'agua dos resultados do seu treino.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>O Athly le treinos de corrida do Apple Health para exibir suas atividades na tela de integracao.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>O Athly salva suas corridas no Apple Health para manter seu historico de atividades atualizado.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Athly precisa de acesso continuo a localizacao para rastrear sua corrida mesmo com a tela bloqueada.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Athly precisa de acesso continuo a localizacao para rastrear sua corrida em segundo plano.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Athly precisa da sua localizacao para registrar o percurso da corrida em tempo real.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>O Athly salva na sua galeria as fotos com a marca d'agua do treino.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<false/>
	<key>OTEL_API_KEY</key>
	<string>$(OTEL_API_KEY)</string>
	<key>OTEL_ENDPOINT</key>
	<string>$(OTEL_ENDPOINT)</string>
	<key>REVENUECAT_API_KEY</key>
	<string>$(REVENUECAT_API_KEY)</string>
	<key>UIAppFonts</key>
	<array>
		<string>SpaceGrotesk-Regular.ttf</string>
		<string>SpaceGrotesk-Medium.ttf</string>
		<string>SpaceGrotesk-SemiBold.ttf</string>
		<string>SpaceGrotesk-Bold.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
		<string>location-services</string>
		<string>gps</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
