{
  "name": "athly-project",
  "version": "1.1.0",
  "private": true,
  "description": "Monorepo Athly — tooling de release (semantic-release + commitlint). Nao e um workspace npm: athly-backend e athly-frontend tem suas proprias instalacoes.",
  "scripts": {
    "prepare": "husky",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "husky": "^9.1.7",
    "semantic-release": "^24.2.3"
  }
}
