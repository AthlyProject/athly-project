{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Requests (1 h)",
      "type": "stat",
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(athly_http_server_duration_milliseconds_count[1h]))",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Error Rate",
      "type": "stat",
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(athly_http_server_duration_milliseconds_count{http_status_code=~\"[45]..\"}[5m])) / sum(rate(athly_http_server_duration_milliseconds_count[5m])) * 100",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent",
          "noValue": "0 %"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "P99 Latency",
      "type": "stat",
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(athly_http_server_duration_milliseconds_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 1000 }
            ]
          },
          "unit": "ms",
          "noValue": "—"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Req / sec",
      "type": "stat",
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(athly_http_server_duration_milliseconds_count[1m]))",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "text", "mode": "fixed" },
          "unit": "reqps",
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Request Rate by Method & Status",
      "type": "timeseries",
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (http_method, http_status_code) (rate(athly_http_server_duration_milliseconds_count[1m]))",
          "refId": "A",
          "legendFormat": "{{http_method}} {{http_status_code}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Latency Percentiles",
      "type": "timeseries",
      "datasource": { "uid": "prometheus", "type": "prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(athly_http_server_duration_milliseconds_bucket[1m])) by (le))",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(athly_http_server_duration_milliseconds_bucket[1m])) by (le))",
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(athly_http_server_duration_milliseconds_bucket[1m])) by (le))",
          "refId": "C",
          "legendFormat": "p99"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "collapsed": false,
      "title": "Logs",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }
    },
    {
      "id": 8,
      "title": "Log Volume by Level",
      "type": "timeseries",
      "datasource": { "uid": "loki", "type": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({service_name=\"athly/athly-backend\"} [1m]))",
          "refId": "A",
          "legendFormat": "{{level}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "drawStyle": "bars",
            "barAlignment": 0
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ERROR" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "WARN" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "INFO" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          }
        ]
      }
    },
    {
      "id": 9,
      "title": "Log Stream",
      "type": "logs",
      "datasource": { "uid": "loki", "type": "loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "{service_name=\"athly/athly-backend\"}",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 10,
      "collapsed": false,
      "title": "Traces",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 }
    },
    {
      "id": 11,
      "title": "Recent Traces",
      "type": "traces",
      "datasource": { "uid": "tempo", "type": "tempo" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 37 },
      "targets": [
        {
          "filters": [],
          "limit": 20,
          "queryType": "traceql",
          "query": "{ resource.service.name = \"athly-backend\" }",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "options": {
        "frameType": "TraceqlSearch"
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["athly"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Athly Backend",
  "uid": "athly-backend",
  "version": 1
}
