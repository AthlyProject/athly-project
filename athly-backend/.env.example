NODE_ENV=development
# OpenTelemetry — local dev (docker-compose LGTM stack)
# NODE_OPTIONS and OTEL_*_EXPORTER are injected via docker-compose environment: section
OTEL_SERVICE_NAME=athly-backend
OTEL_RESOURCE_ATTRIBUTES=service.namespace=athly,deployment.environment=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_NODE_RESOURCE_DETECTORS=env,host,os

# Production (Grafana Cloud) — set these in your deployment environment:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instanceID:apiToken)>

# JWT
JWT_SECRET="seu_secret_super_seguro_aqui_mude_em_producao"
JWT_EXPIRES_IN="1h"

# Login social (iOS)
# Google: client ID do OAuth client do tipo "iOS" no Google Cloud (audience do id_token).
GOOGLE_IOS_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
# Apple: bundle id do app iOS (audience do identity token do Sign in with Apple).
APPLE_CLIENT_ID="com.athly.runner"

# Server
PORT=4000

# Google Gemini API Key
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="sua_gemini_api_key"
# Modelo robusto para criar o plano semanal. Override opcional.
GEMINI_PLANNER_MODEL="gemini-3-flash-preview"
# Modelo barato para interpretar objetivo em texto livre. Override opcional.
GEMINI_GOAL_PARSER_MODEL="gemini-3.1-flash-lite"

# Redis (opcional — usado para cache de respostas da IA)
REDIS_URL=redis://localhost:6379

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iafit
DATABASE_URL="postgresql://user:password@localhost:5432/iafit"

# AWS SES — used for transactional emails (welcome, confirmation, etc.)
AWS_REGION="eu-central-1"
AWS_SQS_PLAN_GENERATION_QUEUE_URL="https://sqs.eu-central-1.amazonaws.com/730335545778/training-plan-generation"
SES_SENDER_EMAIL="noreply@athlyproject.app"

# Admin-only endpoints (e.g., GET /weekly-goals/:id/admin-report). Comma-separated emails.
ADMIN_EMAILS="alexandrefonseca998@gmail.com"

# Paywall / RevenueCat (assinatura). Mantenha PAYWALL_ENABLED=false até o RevenueCat + App Store
# Connect estarem configurados — com false, todo o gating é fail-open (ninguém é bloqueado).
PAYWALL_ENABLED=false
# Segredo do header Authorization do webhook do RevenueCat (deixe vazio enquanto não configurado).
REVENUECAT_WEBHOOK_AUTH=""
