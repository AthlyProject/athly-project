# OpenTelemetry — LGTM stack
# Local dev: points to the OTel Collector service in docker-compose
OTEL_SERVICE_NAME=athly-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Production (Grafana Cloud) — replace with your stack's OTLP endpoint + token:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instanceID:apiToken)>

# JWT
JWT_SECRET="seu_secret_super_seguro_aqui_mude_em_producao"
JWT_EXPIRES_IN="1h"

# Server
PORT=4000

# Google Gemini API Key
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="sua_gemini_api_key"

# Redis (opcional — usado para cache de respostas da IA)
REDIS_URL=redis://localhost:6379

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iafit
DATABASE_URL="postgresql://user:password@localhost:5432/iafit"

# AWS SES — used for transactional emails (welcome, confirmation, etc.)
AWS_REGION="eu-central-1"
SES_SENDER_EMAIL="noreply@athlyproject.app"

# Admin-only endpoints (e.g., GET /weekly-goals/:id/admin-report). Comma-separated emails.
ADMIN_EMAILS="alexandrefonseca998@gmail.com"

# Paywall / RevenueCat (assinatura). Mantenha PAYWALL_ENABLED=false até o RevenueCat + App Store
# Connect estarem configurados — com false, todo o gating é fail-open (ninguém é bloqueado).
PAYWALL_ENABLED=false
# Segredo do header Authorization do webhook do RevenueCat (deixe vazio enquanto não configurado).
REVENUECAT_WEBHOOK_AUTH=""
