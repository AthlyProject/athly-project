    {
      "id": "strava_header",
      "type": "text",
      "x": 600,
      "y": -50,
      "width": 200,
      "height": 40,
      "text": "## STRAVA API"
    },
    {
      "id": "f1",
      "type": "text",
      "x": 0,
      "y": 50,
      "width": 200,
      "height": 80,
      "text": "Click \"Conectar Strava\"\n\nGET /integrations/strava/auth"
    },
    {
      "id": "b1",
      "type": "text",
      "x": 300,
      "y": 50,
      "width": 200,
      "height": 80,
      "text": "Gera URL OAuth\n\ncom state parameter\nretorna authUrl"
    },
    {
      "id": "f2",
      "type": "text",
      "x": 0,
      "y": 180,
      "width": 200,
      "height": 80,
      "text": "window.open(authUrl)\n\nNova aba"
    },
    {
      "id": "s1",
      "type": "text",
      "x": 600,
      "y": 180,
      "width": 200,
      "height": 80,
      "text": "Strava login\n\nConfirm scope"
    },
    {
      "id": "s2",
      "type": "text",
      "x": 600,
      "y": 310,
      "width": 200,
      "height": 80,
      "text": "Redirect com code\n\n?code=ABC123&state=xyz"
    },
    {
      "id": "f3",
      "type": "text",
      "x": 0,
      "y": 310,
      "width": 200,
      "height": 80,
      "text": "OAuthCallbackPage\n\nParse URL\ncode = ABC123"
    },
    {
      "id": "f4",
      "type": "text",
      "x": 0,
      "y": 440,
      "width": 200,
      "height": 80,
      "text": "POST /integrations/strava/callback?code=ABC123\n\nLoading spinner"
    },
    {
      "id": "b2",
      "type": "text",
      "x": 300,
      "y": 440,
      "width": 200,
      "height": 80,
      "text": "POST /oauth/token\n\nClient credentials + code"
    },
    {
      "id": "s3",
      "type": "text",
      "x": 600,
      "y": 440,
      "width": 200,
      "height": 80,
      "text": "Valida code\n\nRetorna access_token\nrefresh_token\nexpiresAt"
    },
    {
      "id": "b3",
      "type": "text",
      "x": 300,
      "y": 570,
      "width": 200,
      "height": 80,
      "text": "Salva em BD\n\nIntegration(\n  accessToken,\n  refreshToken\n)"
    },
    {
      "id": "f5",
      "type": "text",
      "x": 0,
      "y": 570,
      "width": 200,
      "height": 80,
      "text": "200 OK\n\nToast: \"Conectado!\"\nRedirect /dashboard"
    }
  ],
